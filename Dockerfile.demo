# syntax=docker/dockerfile:1.7

# Static-demo image. Builds the SPA in demo mode (mock telemetry, no
# backend) and serves it from nginx — the same artefact the GitHub Pages
# workflow publishes, packaged for self-hosting.
#
# Build context is the repo root because the demo build needs both `web/`
# (the SPA) and `demo/` (dashboards + widget libraries the sync script
# bundles into web/app/demo/data/_bundled.json).
#
# Build:
#   docker build -f Dockerfile.demo -t oteldash-demo .
#   docker build -f Dockerfile.demo --build-arg NUXT_APP_BASE_URL=/foo/ -t oteldash-demo .
#
# Run:
#   docker run --rm -p 8080:8080 oteldash-demo

# ---- Build the static bundle ----------------------------------------
FROM node:22-alpine AS web-build
WORKDIR /repo
ENV CI=1

# `app.baseURL` baked into the bundle. Default is '/' (root). For a
# subpath deploy (e.g. behind a reverse proxy at /demo/), pass
# `--build-arg NUXT_APP_BASE_URL=/demo/`.
ARG NUXT_APP_BASE_URL=/

COPY web/package.json web/pnpm-lock.yaml ./web/
# `corepack prepare` pins the same pnpm version package.json declares —
# without it newer corepack pulls pnpm 11.x and pnpm 11+ refuses to
# downshift to the project's 10.33.0 under corepack, breaking the build.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    corepack enable && \
    corepack prepare pnpm@10.33.0 --activate && \
    pnpm -C web install --prefer-frozen-lockfile

# Copy what the demo build actually reads:
#   - web/ → the SPA source
#   - demo/packs/ → consumed by scripts/sync-demo-fixtures.mjs to
#     produce _bundled.json (each pack contributes its libraries[]
#     and dashboards[]).
COPY web/ ./web/
COPY demo/packs/ ./demo/packs/

ENV VITE_DEMO_MODE=true
ENV NUXT_APP_BASE_URL=${NUXT_APP_BASE_URL}
RUN pnpm -C web run generate:demo

# Pages serves index.html for missing routes via 404.html. Replicate the
# same fallback inside the image so deep-link refreshes work behind any
# server (the inline nginx.conf below also wires `try_files`).
RUN cp /repo/web/.output/public/index.html /repo/web/.output/public/404.html

# ---- Serve via nginx -------------------------------------------------
# `nginxinc/nginx-unprivileged` is the official non-root variant. It runs
# as uid 101, listens on 8080 by default, and has the cache dirs
# pre-chowned — so we don't need a `chown -R` or to fight the
# entrypoint's read-only conf checks.
FROM nginxinc/nginx-unprivileged:1.27-alpine

# SPA fallback so client-side routing survives hard refreshes. Cache
# `_nuxt/` (hashed file names) aggressively; everything else short-TTL.
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Hashed Nuxt assets — safe to cache forever.
    location /_nuxt/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: any unknown path returns index.html so
    # vue-router can take over.
    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    # Healthcheck endpoint hit by the HEALTHCHECK directive below.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
EOF

COPY --from=web-build --chown=101:101 /repo/web/.output/public /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O - http://localhost:8080/healthz >/dev/null 2>&1 || exit 1
