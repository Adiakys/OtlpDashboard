{
  "name": "Error rate gauge",
  "description": "Radial gauge for an error percentage (0–100). Three colored bands at 1% / 5% to flag SLO breaches.",
  "icon": "i-ph-warning-octagon",
  "defaultSize": { "w": 3, "h": 3 },
  "engine": "preset",
  "baseKind": "metric-gauge",
  "defaultConfig": {
    "metric": null,
    "range": "last-15m",
    "calc": "last",
    "unitKind": "percent",
    "decimals": 2,
    "min": 0,
    "max": 100,
    "thresholds": [
      { "value": 0, "color": "#7AAA7A" },
      { "value": 1, "color": "#D9B566" },
      { "value": 5, "color": "#E27A3F" }
    ]
  }
}
