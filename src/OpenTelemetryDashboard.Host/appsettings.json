{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./data/telemetry.db"
  },
  "Dashboard": {
    "ApplicationName": "OTel Dashboard",
    "BrowserToken": "",
    "Otlp": {
      "ApiKey": ""
    },
    "Storage": { "Provider": "Sqlite" },
    "TelemetryLimits": {
      "MaxLogDays": 0,
      "MaxTraceDays": 0,
      "MaxMetricDays": 0,
      "SweepIntervalMinutes": 60
    },
    "Widgets": {
      "LibrariesPaths": [
        "./data/widget-libraries",
        "./builtin-libraries"
      ],
      "MaxLibraries": 32
    },
    "Dashboards": {
      "BuiltinPaths": [
        "./builtin-dashboards"
      ]
    },
    "Mcp": {
      "Enabled": false
    },
    "Ingestion": {
      "Grpc": {
        "Port": 4317,
        "MaxReceiveMessageSize": 16777216
      },
      "Http": {
        "Port": 4318,
        "MaxRequestBodySize": 16777216,
        "RateLimit": {
          "PermitsPerSecond": 200,
          "Burst": 500
        }
      },
      "Channel": {
        "Capacity": 10000,
        "MaxBatchSize": 512,
        "FlushIntervalMs": 250
      },
      "Shutdown": {
        "DrainTimeoutSeconds": 30
      }
    },
    "QueryApi": {
      "DefaultLimit": 1000,
      "MaxLimit": 10000,
      "MaxWindowHours": 2160
    },
    "ServiceMap": {
      "DependencyAttributes": [
        "db.system",
        "messaging.system"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning"
    }
  }
}
