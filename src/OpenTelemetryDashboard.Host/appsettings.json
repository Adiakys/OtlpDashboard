{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetryDashboard": {
    "Ingestion": {
      "Grpc": {
        "Port": 4317,
        "MaxReceiveMessageSize": 16777216
      },
      "Http": {
        "Port": 4318,
        "MaxRequestBodySize": 16777216,
        "RateLimit": {
          "PermitsPerSecond": 200,
          "Burst": 500
        }
      },
      "Channel": {
        "Capacity": 10000,
        "MaxBatchSize": 512,
        "FlushIntervalMs": 250
      },
      "Shutdown": {
        "DrainTimeoutSeconds": 30
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": {
        "ConnectionString": "Data Source=./data/telemetry.db"
      }
    },
    "Metrics": {
      "InMemory": {
        "MaxInstruments": 5000,
        "MaxPointsPerInstrument": 1000
      }
    },
    "QueryApi": {
      "DefaultLimit": 100,
      "MaxLimit": 1000,
      "MaxWindowHours": 24
    }
  },
  "Dashboard": {
    "ApplicationName": "OTel Dashboard",
    "BrowserToken": "",
    "Otlp": {
      "ApiKey": ""
    },
    "TelemetryLimits": {
      "MaxLogDays": 0,
      "MaxTraceDays": 0,
      "MaxMetricDays": 0,
      "SweepIntervalMinutes": 60
    }
  }
}
