{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./data/telemetry.db"
  },
  "Dashboard": {
    "ApplicationName": "OTel Dashboard",
    "BrowserToken": "",
    "Otlp": {
      "ApiKey": ""
    },
    "Storage": { "Provider": "Sqlite" },
    "TelemetryLimits": {
      "MaxLogDays": 0,
      "MaxTraceDays": 0,
      "MaxMetricDays": 0,
      "SweepIntervalMinutes": 60
    },
    "Packs": {
      "Paths": [
        "./data/packs",
        "./builtin-packs"
      ],
      "MaxPacks": 32
    },
    "Mcp": {
      "Enabled": false
    },
    "Ingestion": {
      "Grpc": {
        "Port": 4317,
        "MaxReceiveMessageSize": 16777216
      },
      "Http": {
        "Port": 4318,
        "MaxRequestBodySize": 16777216
      },
      "Channel": {
        "Capacity": 10000,
        "MaxBatchSize": 512,
        "FlushIntervalMs": 250
      },
      "Shutdown": {
        "DrainTimeoutSeconds": 30
      }
    },
    "RateLimits": {
      "OtlpIngest": { "PermitsPerSecond": 200, "Burst": 500 },
      "ReadApi": { "PermitsPerSecond": 60, "Burst": 120 },
      "Mutations": { "PermitsPerSecond": 10, "Burst": 30 },
      "PackInstall": { "MaxConcurrent": 1, "ConcurrencyQueueLimit": 3 }
    },
    "QueryApi": {
      "DefaultLimit": 1000,
      "MaxLimit": 10000,
      "MaxWindowHours": 2160,
      "MaxMetricPoints": 50000,
      "MaxSpansPerTrace": 5000
    },
    "ServiceMap": {
      "DependencyAttributes": [
        "service.peer.name",
        "db.system",
        "messaging.system",
        "rpc.system",
        "peer.service"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning"
    }
  }
}
