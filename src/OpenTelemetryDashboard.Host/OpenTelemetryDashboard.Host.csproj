<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UserSecretsId>OpenTelemetryDashboard.Host</UserSecretsId>
    <AssemblyName>OpenTelemetryDashboard.Host</AssemblyName>
    <RootNamespace>OpenTelemetryDashboard.Host</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTelemetryDashboard.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTelemetryDashboard.Core\OpenTelemetryDashboard.Core.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Dashboards\OpenTelemetryDashboard.Dashboards.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence\OpenTelemetryDashboard.Persistence.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence.Sqlite\OpenTelemetryDashboard.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence.SqlServer\OpenTelemetryDashboard.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence.PostgreSql\OpenTelemetryDashboard.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Ingestion\OpenTelemetryDashboard.Ingestion.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Api\OpenTelemetryDashboard.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup Label="Self-instrumentation (opt-in via Dashboard:SelfInstrumentation:Enabled)">
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" />
  </ItemGroup>

</Project>
