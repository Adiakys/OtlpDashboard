<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UserSecretsId>OpenTelemetryDashboard.Host</UserSecretsId>
    <AssemblyName>OpenTelemetryDashboard.Host</AssemblyName>
    <RootNamespace>OpenTelemetryDashboard.Host</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTelemetryDashboard.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTelemetryDashboard.Core\OpenTelemetryDashboard.Core.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence\OpenTelemetryDashboard.Persistence.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Persistence.Sqlite\OpenTelemetryDashboard.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Ingestion\OpenTelemetryDashboard.Ingestion.csproj" />
    <ProjectReference Include="..\OpenTelemetryDashboard.Api\OpenTelemetryDashboard.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
