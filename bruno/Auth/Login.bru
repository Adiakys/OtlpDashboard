meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "token": "{{browserToken}}"
  }
}

docs {
  Scambia il `BrowserToken` per un cookie HttpOnly (`auth`).
  Risposta: 204 No Content in caso di successo, 401 altrimenti.
}
