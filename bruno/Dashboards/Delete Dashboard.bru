meta {
  name: Delete Dashboard
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboardId}}?rowVersion=1
  body: none
  auth: inherit
}

params:query {
  rowVersion: 1
}

docs {
  Richiede `rowVersion` come query string (concorrenza ottimistica).
  La dashboard di default non è cancellabile (400).
}
