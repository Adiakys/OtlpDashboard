{
  "name": "GC collections by gen",
  "description": "Cumulative GC collection count, split by heap generation (gen0/gen1/gen2). Bound to dotnet.gc.collections \u2014 the bar widget shows one bar per gen.",
  "icon": "i-ph-recycle",
  "defaultSize": {
    "w": 4,
    "h": 4
  },
  "engine": "preset",
  "baseKind": "metric-bar-gauge",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.gc.collections",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-1h",
    "splitBy": "gc.heap.generation",
    "calc": "last",
    "unitKind": "none",
    "decimals": 0,
    "topN": 10,
    "min": 0,
    "max": null,
    "thresholds": []
  }
}
