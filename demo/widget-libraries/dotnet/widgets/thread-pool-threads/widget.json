{
  "name": "ThreadPool threads",
  "description": "Number of thread-pool threads currently in use. Bound to dotnet.thread_pool.thread.count.",
  "icon": "i-ph-cpu",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.thread_pool.thread.count",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last"
  }
}
