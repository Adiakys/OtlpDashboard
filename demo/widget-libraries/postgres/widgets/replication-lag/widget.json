{
  "name": "Replication lag",
  "description": "Wall-clock seconds the replica is behind the primary. Bound to postgresql.replication.data_delay. Only emitted when at least one replica is configured.",
  "icon": "i-ph-arrow-square-out",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.replication.data_delay",
      "kind": "Gauge",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 1,
    "unitKind": "seconds",
    "calc": "last",
    "thresholds": [
      {
        "value": 0,
        "color": "#7AAA7A"
      },
      {
        "value": 5,
        "color": "#D9B566"
      },
      {
        "value": 30,
        "color": "#E27A3F"
      }
    ]
  }
}
