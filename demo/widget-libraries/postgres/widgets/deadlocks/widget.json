{
  "name": "Deadlocks",
  "description": "Cumulative deadlocks detected. Bind to 'postgresql.deadlocks'. Anything above zero is worth investigating.",
  "icon": "i-ph-warning-octagon",
  "defaultSize": { "w": 3, "h": 3 },
  "engine": "preset",
  "baseKind": "metric-stat",
  "defaultConfig": {
    "metric": null,
    "range": "last-1h",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last",
    "thresholds": [
      { "value": 0, "color": "#7AAA7A" },
      { "value": 1, "color": "#D9B566" },
      { "value": 10, "color": "#E27A3F" }
    ]
  }
}
