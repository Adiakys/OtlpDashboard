{
  "name": "Operations mix",
  "description": "Bar gauge of insert/update/delete/HOT operations split by `operation`. Bound to postgresql.operations \u2014 quick view of the write profile.",
  "icon": "i-ph-arrows-split",
  "defaultSize": {
    "w": 5,
    "h": 4
  },
  "engine": "preset",
  "baseKind": "metric-bar-gauge",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.operations",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-1h",
    "splitBy": "operation",
    "calc": "last",
    "unitKind": "none",
    "decimals": 0,
    "topN": 10,
    "min": 0,
    "max": null,
    "thresholds": []
  }
}
