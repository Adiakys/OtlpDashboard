{
  "name": "WAL age",
  "description": "Age (seconds) of the oldest WAL segment on the primary. Bind to 'postgresql.wal.age'. High values may signal stuck replication slots or long-running tx.",
  "icon": "i-ph-clock-countdown",
  "defaultSize": { "w": 3, "h": 3 },
  "engine": "preset",
  "baseKind": "metric-stat",
  "defaultConfig": {
    "metric": null,
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "seconds",
    "calc": "last",
    "thresholds": [
      { "value": 0, "color": "#7AAA7A" },
      { "value": 600, "color": "#D9B566" },
      { "value": 3600, "color": "#E27A3F" }
    ]
  }
}
