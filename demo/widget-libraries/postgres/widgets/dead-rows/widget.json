{
  "name": "Dead rows",
  "description": "Estimated number of dead (vacuumable) rows per table. Bind to 'postgresql.dead_rows'. Climbing values + low vacuum frequency = bloat.",
  "icon": "i-ph-trash",
  "defaultSize": { "w": 3, "h": 3 },
  "engine": "preset",
  "baseKind": "metric-stat",
  "defaultConfig": {
    "metric": null,
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last",
    "thresholds": [
      { "value": 0, "color": "#7AAA7A" },
      { "value": 10000, "color": "#D9B566" },
      { "value": 100000, "color": "#E27A3F" }
    ]
  }
}
