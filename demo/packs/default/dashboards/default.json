        "title": "sample-client / client-1",
        "bindings": {}
      }
    },

    {
      "id": "c4d51234-1234-5678-90ab-000000000020",
      "kind": "library:postgres/postgres-server-card",
      "x": 0, "y": 7, "w": 12, "h": 5,
      "config": {
        "parameters": { "service": "postgresql", "instance": "telemetry" },
        "range": "last-15m",
        "title": "PostgreSQL — telemetry DB (overrides per cluster-level)",
        "bindings": {
          "dbCount": {
            "resourceHash": "",
            "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
            "instrumentName": "postgresql.database.count",
            "kind": "Sum",
            "serviceName": "postgresql",
            "serviceInstanceId": "postgres:5432"
          }
        }
      }
    },

    {
      "id": "c4d51234-1234-5678-90ab-000000000060",
      "kind": "library:postgres/db-load",
      "x": 0, "y": 12, "w": 6, "h": 5,
      "config": {
        "parameters": { "service": "postgresql", "instance": "telemetry" },
        "range": "last-15m",
        "title": "PostgreSQL — telemetry DB",
        "bindings": {
          "max": {
            "resourceHash": "",
            "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
            "instrumentName": "postgresql.connection.max",
            "kind": "Gauge",
            "serviceName": "postgresql",
            "serviceInstanceId": "postgres:5432"
          }
        }
      }
    },
    {
      "id": "c4d51234-1234-5678-90ab-000000000061",
