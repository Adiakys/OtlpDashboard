{
  "name": "GC committed memory",
  "description": "Total committed memory of the managed GC heap. Bound to dotnet.gc.last_collection.memory.committed_size.",
  "icon": "i-ph-memory",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.gc.last_collection.memory.committed_size",
      "kind": "Sum",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 1,
    "unitKind": "bytes",
    "calc": "last"
  }
}
