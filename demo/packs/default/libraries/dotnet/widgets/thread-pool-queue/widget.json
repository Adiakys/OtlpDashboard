{
  "name": "ThreadPool queue length",
  "description": "Pending work items in the thread-pool queue. Sustained values > 0 mean the runtime is starving for threads. Bound to dotnet.thread_pool.queue.length. Thresholds: green ≤ 1, amber > 5, red > 50.",
  "icon": "i-ph-queue",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.thread_pool.queue.length",
      "kind": "Sum",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last",
    "thresholds": [
      {
        "value": 0,
        "color": "#7AAA7A"
      },
      {
        "value": 5,
        "color": "#D9B566"
      },
      {
        "value": 50,
        "color": "#E27A3F"
      }
    ]
  }
}
