{
  "name": "Assemblies loaded",
  "description": "Currently loaded managed assemblies. Pick the application; the widget binds to dotnet.assembly.count automatically. Useful to spot plugin-load leaks (count keeps growing).",
  "icon": "i-ph-package",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.assembly.count",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "showSparkline": false,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last"
  }
}
