{
  "name": "Lock contention",
  "description": "Cumulative number of times threads contended for a managed lock. Bound to dotnet.monitor.lock_contentions \u2014 sustained slope = a hot lock somewhere.",
  "icon": "i-ph-lock",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.monitor.lock_contentions",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last"
  }
}
