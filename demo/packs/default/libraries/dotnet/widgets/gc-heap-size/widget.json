{
  "name": "GC heap size",
  "description": "Current managed heap size in bytes (post last collection). Bound to dotnet.gc.last_collection.heap.size.",
  "icon": "i-ph-stack",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Application",
      "required": true,
      "default": "sample-server"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "System.Runtime",
      "instrumentName": "dotnet.gc.last_collection.heap.size",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 1,
    "unitKind": "bytes",
    "calc": "last"
  }
}
