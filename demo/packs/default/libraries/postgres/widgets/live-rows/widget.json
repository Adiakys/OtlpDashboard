{
  "name": "Live rows",
  "description": "Estimated live row count per table. Bound to postgresql.live_rows.",
  "icon": "i-ph-rows",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.live_rows",
      "kind": "Sum",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last"
  }
}
