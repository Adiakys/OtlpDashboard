{
  "name": "Database size",
  "description": "On-disk size of the Postgres database(s). Bound to postgresql.db_size (split by postgresql.database.name when the collector emits per-DB).",
  "icon": "i-ph-hard-drives",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.db_size",
      "kind": "Sum",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 1,
    "unitKind": "bytes",
    "calc": "last"
  }
}
