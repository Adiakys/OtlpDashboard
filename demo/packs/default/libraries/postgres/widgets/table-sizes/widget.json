{
  "name": "Table sizes",
  "description": "Top tables by on-disk size. Bound to postgresql.table.size; the bar gauge splits by postgresql.table.name so you see one bar per table.",
  "icon": "i-ph-table",
  "defaultSize": {
    "w": 6,
    "h": 5
  },
  "engine": "preset",
  "baseKind": "metric-bar-gauge",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.table.size",
      "kind": "Sum",
      "serviceName": "${service}"
    },
    "range": "last-15m",
    "splitBy": "postgresql.table.name",
    "calc": "last",
    "unitKind": "bytes",
    "decimals": 1,
    "topN": 10,
    "min": 0,
    "max": null,
    "thresholds": []
  }
}
