{
  "name": "Commits",
  "description": "Cumulative committed transactions per database. Bound to postgresql.commits \u2014 the line view lets you spot traffic regime changes.",
  "icon": "i-ph-check-circle",
  "defaultSize": {
    "w": 6,
    "h": 4
  },
  "engine": "preset",
  "baseKind": "metric-line",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    }
  ],
  "defaultConfig": {
    "metrics": [],
    "range": "last-1h",
    "splitBy": null,
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.commits",
      "kind": "Sum",
      "serviceName": "${service}"
    }
  }
}
