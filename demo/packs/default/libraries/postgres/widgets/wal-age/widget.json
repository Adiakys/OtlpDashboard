{
  "name": "WAL age",
  "description": "Age (seconds) of the oldest WAL segment on the primary. Bound to postgresql.wal.age. High values may signal stuck replication.",
  "icon": "i-ph-clock-countdown",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.wal.age",
      "kind": "Gauge",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "seconds",
    "calc": "last",
    "thresholds": [
      {
        "value": 0,
        "color": "#7AAA7A"
      },
      {
        "value": 600,
        "color": "#D9B566"
      },
      {
        "value": 3600,
        "color": "#E27A3F"
      }
    ]
  }
}
