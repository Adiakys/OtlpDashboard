{
  "name": "Dead rows",
  "description": "Estimated number of dead (vacuumable) rows per table. Bound to postgresql.dead_rows. Climbing values + low vacuum frequency = bloat.",
  "icon": "i-ph-trash",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "engine": "preset",
  "baseKind": "metric-stat",
  "parameters": [
    {
      "name": "service",
      "type": "service_name",
      "label": "Service",
      "required": true,
      "default": "postgresql"
    },
    {
      "name": "instance",
      "type": "service_instance_id",
      "label": "Instance",
      "dependsOn": "service",
      "description": "Pin a specific service.instance.id when the service has multiple replicas."
    }
  ],
  "defaultConfig": {
    "metric": {
      "resourceHash": "",
      "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver",
      "instrumentName": "postgresql.dead_rows",
      "kind": "Sum",
      "serviceName": "${service}",
      "serviceInstanceId": "${instance}"
    },
    "range": "last-15m",
    "showSparkline": true,
    "decimals": 0,
    "unitKind": "none",
    "calc": "last",
    "thresholds": [
      {
        "value": 0,
        "color": "#7AAA7A"
      },
      {
        "value": 10000,
        "color": "#D9B566"
      },
      {
        "value": 100000,
        "color": "#E27A3F"
      }
    ]
  }
}
