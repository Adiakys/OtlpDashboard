{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000001",
  "name": "Test stack overview",
  "widgets": [
    {
      "id": "c4d51234-1234-5678-90ab-000000000001",
      "kind": "std:text",
      "x": 0, "y": 0, "w": 12, "h": 2,
      "config": {
        "markdown": "## OpenTelemetry test stack\n\nDashboard pre-impaginata e **pre-bindata** sul compose di test (sample-server + sample-client + postgres + redis). I binding `resourceHash` vuoti vengono risolti a runtime dal catalogo strumenti via logical key (`scope + name + kind + serviceName`), quindi al primo tick di telemetria i widget si popolano da soli.\n\n*Le tue modifiche sono persistenti — questa default non viene riscritta dopo che la modifichi.*",
        "align": "left"
      }
    },

    {
      "id": "c4d51234-1234-5678-90ab-000000000002",
      "kind": "library:dotnet/runtime-overview",
      "x": 0, "y": 2, "w": 6, "h": 4,
      "config": {
        "bindings": {
          "heap":       { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.gc.heap.size",            "kind": "Sum", "serviceName": "sample-server" },
          "committed":  { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.gc.committed_memory.size", "kind": "Sum", "serviceName": "sample-server" },
          "threads":    { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.thread_pool.threads.count","kind": "Sum", "serviceName": "sample-server" },
          "exceptions": { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.exceptions.count",         "kind": "Sum", "serviceName": "sample-server" },
          "gc":         { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.gc.collections.count",     "kind": "Sum", "serviceName": "sample-server" },
          "contention": { "resourceHash": "", "scopeName": "OpenTelemetry.Instrumentation.Runtime", "instrumentName": "process.runtime.dotnet.monitor.lock_contention.count", "kind": "Sum", "serviceName": "sample-server" }
        },
        "range": "last-15m",
        "title": ".NET runtime — sample-server"
      }
    },
    {
      "id": "c4d51234-1234-5678-90ab-000000000003",
      "kind": "library:postgres/postgres-server-card",
      "x": 6, "y": 2, "w": 6, "h": 4,
      "config": {
        "bindings": {
          "backends":   { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.backends",               "kind": "Sum",   "serviceName": "postgresql" },
          "dbCount":    { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.database.count",         "kind": "Sum",   "serviceName": "postgresql" },
          "tableCount": { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.table.count",            "kind": "Sum",   "serviceName": "postgresql" },
          "totalSize":  { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.db_size",                "kind": "Sum",   "serviceName": "postgresql" },
          "walAge":     { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.wal.age",                "kind": "Gauge", "serviceName": "postgresql" },
          "replLag":    { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.replication.data_delay", "kind": "Gauge", "serviceName": "postgresql" }
        },
        "range": "last-15m",
        "title": "PostgreSQL cluster"
      }
    },

