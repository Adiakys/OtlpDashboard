          "rollbacks": { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.rollbacks", "kind": "Sum", "serviceName": "postgresql" },
          "deadlocks": { "resourceHash": "", "scopeName": "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/postgresqlreceiver", "instrumentName": "postgresql.deadlocks", "kind": "Sum", "serviceName": "postgresql" }
